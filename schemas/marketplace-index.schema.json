{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/marketplace-index.schema.json",
  "title": "Spirit Agent Marketplace Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "extensionId",
          "packageName",
          "channel",
          "status",
          "featured"
        ],
        "properties": {
          "extensionId": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    }
  }
}