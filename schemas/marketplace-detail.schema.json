{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N123999/awesome-SpiritAgent/refs/heads/main/schemas/marketplace-detail.schema.json",
  "title": "Spirit Agent Marketplace Detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "packageName",
    "status",
    "featured",
    "defaultVersion",
    "versions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "extensionId": {
      "type": "string"
    },
    "packageName": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "defaultVersion": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "channel",
          "reviewStatus",
          "displayName",
          "description",
          "supportedHosts",
          "requestedCapabilities"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "preview",
              "experimental"
            ]
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "revoked"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "homepageUrl": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supportedHosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requestedCapabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iconUrl": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "tarballUrl": {
            "type": "string"
          },
          "integrity": {
            "type": "string"
          },
          "shasum": {
            "type": "string"
          },
          "changelog": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "body"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}